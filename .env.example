DATABASE_URL="file:./dev.db"
JWT_SECRET="change-me"
ADMIN_EMAIL="admin@fcfrick.ch"
ADMIN_PASSWORD="change-me"
ADMIN_NAME="Tournament Admin"
PORT=3000

# Browser origins allowed to call this API, comma-separated, no trailing slash.
# Leave unset locally: dev and preview reach the API through Vite's /api proxy,
# so requests are same-origin and CORS is not involved. Only a frontend deployed
# on its own domain needs this.
# CORS_ORIGIN="https://your-app.vercel.app"
