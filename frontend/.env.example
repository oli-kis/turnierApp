# Dev/preview only: where the Vite server forwards /api. Never reaches the bundle.
VITE_API_URL=http://localhost:3000

# Production only: the absolute API origin baked into the built bundle, for a
# static deployment where no Vite proxy exists. Leave unset locally, or the app
# stops using the proxy and a phone on the LAN can no longer reach the API.
# The backend must list this app's own origin in CORS_ORIGIN.
# VITE_API_ORIGIN=https://your-service.onrender.com
